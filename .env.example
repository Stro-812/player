# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Общая RSS-лента (по желанию). 16 случайных символов: лента будет по адресу /feed-<FEED_SLUG>.xml.
# Пусто — лента не собирается. Сгенерировать: node -e "console.log(require('crypto').randomBytes(12).toString('base64url').slice(0,16))"
FEED_SLUG=

# Адрес сайта с https, без слеша в конце. Нужен ленте для ссылок на обложку.
SITE_URL=

# Ключи хостинга появятся, когда будет выбран провайдер (см. README, «Выкладка»).
